# ── Data backend ─────────────────────────────────────────────
# Options: excel | postgres | sap
DATA_BACKEND=excel

# ── PostgreSQL (when DATA_BACKEND=postgres) ───────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=spare_parts
POSTGRES_USER=yamaha_rw
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SSLMODE=disable

# ── SAP (when DATA_BACKEND=sap) ───────────────────────────────
SAP_ASHOST=
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=CHANGE_ME
SAP_LANG=EN

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns

# ── Application ───────────────────────────────────────────────
LOG_LEVEL=INFO
TIMEZONE=Asia/Colombo
CURRENCY=LKR
SERVICE_LEVEL=0.95
LEAD_TIME_DAYS=90
